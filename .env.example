# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- Alpaca paper trading (required for live paper data) -------------------
# Free. https://alpaca.markets -> sign up -> Paper Trading -> generate keys.
# The paper key pair is separate from the live one. This system refuses to
# send orders to a live account regardless of what you put here.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# --- SEC filings (required for insiders, 13F and the tracker leaderboard) ---
# Your own email. The SEC requires automated clients to identify themselves
# with a real contact address, and it is sent to the SEC and nowhere else.
# Leave it blank and the congressional data still works while the SEC sources
# are skipped with a message saying why.
SEC_CONTACT_EMAIL=

# --- Dashboard auth (required to run the API) ------------------------------
# This is the only thing between the internet and the approve button.
PM_DASHBOARD_PASSWORD=
# Generate with: openssl rand -hex 32
PM_SECRET_KEY=
# Set to 0 only when serving over plain http on localhost.
PM_COOKIE_SECURE=1

# --- Claude (optional) -----------------------------------------------------
# Without this the system still runs end to end and writes deterministic
# reasoning instead of model-written theses.
ANTHROPIC_API_KEY=
PM_MODEL=claude-sonnet-5

# --- Schedule --------------------------------------------------------------
# 21:30 UTC is after the US close in both EST and EDT.
PM_RUN_AT_UTC=21:30
PM_SKIP_WEEKENDS=1
PM_RUN_ON_BOOT=0

# --- Deploy ----------------------------------------------------------------
# Any hostname Caddy can get a certificate for. sslip.io resolves any
# *.<your-ip>.sslip.io to that ip, which is the quickest way to a real
# certificate without owning a domain.
PM_HOSTNAME=pm.YOUR-SERVER-IP.sslip.io
ACME_EMAIL=
PM_PORT=8791

# --- News and events -------------------------------------------------------
# Alpaca's news endpoint is used when Alpaca keys are set. Firecrawl is the
# fallback when they are not.
FIRECRAWL_API_KEY=
PM_NEWS_INTERVAL_MIN=20
PM_NEWS_QUIET_INTERVAL_MIN=60

# --- Reasoning backend -----------------------------------------------------
# hermes    every LLM call goes through the opencode server Hermes runs on this
#           box, so the whole system runs on the existing subscription and
#           needs no second API key. This is the default.
# anthropic direct Anthropic API, needs ANTHROPIC_API_KEY. For running off the
#           VPS where Hermes is not reachable.
# none      no reasoning at all; every memo falls back to deterministic text.
PM_LLM_BACKEND=hermes
PM_HERMES_URL=http://172.19.0.1:4096
PM_HERMES_MODEL=opencode-go/kimi-k3
PM_HERMES_TIMEOUT=300
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
